<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>
        <!-- createDatabaseIfNotExist crea la BD "aulas_db" si no existe -->
        <property name="hibernate.connection.url">jdbc:mysql://localhost:3306/aulas_db?createDatabaseIfNotExist=true&amp;useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=UTC</property>
        <property name="hibernate.connection.username">root</property>
        <property name="hibernate.connection.password"></property>

        <!-- Crea/actualiza las tablas automaticamente a partir de las entidades -->
        <property name="hibernate.hbm2ddl.auto">update</property>
        <property name="hibernate.show_sql">false</property>

        <mapping class="edu.ufg.aulas.entidades.Usuario"/>
        <mapping class="edu.ufg.aulas.entidades.TipoAula"/>
        <mapping class="edu.ufg.aulas.entidades.EstadoAula"/>
        <mapping class="edu.ufg.aulas.entidades.Planta"/>
        <mapping class="edu.ufg.aulas.entidades.Aula"/>
    </session-factory>
</hibernate-configuration>
